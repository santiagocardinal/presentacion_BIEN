      line-height: 1.78;
      margin-top: 18px;
      max-width: 260px;
    }

    .footer-col h4 {
      font-size: 0.67rem;
      font-weight: 600;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: rgba(255, 255, 255, 0.26);
      margin-bottom: 18px;
    }
    .footer-col ul {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    .footer-col a {
      font-size: 0.83rem;
      color: rgba(255, 255, 255, 0.44);
      transition: color 0.22s;
    }
    .footer-col a:hover { color: var(--blanco); }

    .footer-pie {
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 0.75rem;
    }

    /* ═══════════════════════════════════════════
       11. BOTÓN VOLVER ARRIBA
    ═══════════════════════════════════════════ */
    #btn-top {
      position: fixed;
      bottom: 28px; right: 28px;
      width: 44px; height: 44px;
      border-radius: var(--radio);
      background: var(--tinta);
      color: var(--blanco);
      border: none;
      cursor: pointer;
      font-size: 1rem;
      display: flex;
      align-items: center;
      justify-content: center;
      opacity: 0;
      pointer-events: none;
      transform: translateY(12px);
      transition: var(--trans);
      box-shadow: 0 8px 24px rgba(10, 22, 40, 0.28);
      z-index: 888;
    }
    #btn-top.visible {
      opacity: 1;
      pointer-events: auto;
      transform: none;
    }
    #btn-top:hover { background: var(--principal); }

    /* ═══════════════════════════════════════════
       12. RESPONSIVE
    ═══════════════════════════════════════════ */
    @media (max-width: 960px) {
      /* Header */
      .nav-desktop { display: none; }
      .burger      { display: flex; }

      /* Hero — el panel inferior ahora siempre es visible, ajustar grid de stats y pasos */
      .hero-izq    { padding: 64px 28px 56px; }
      .panel-stats       { grid-template-columns: repeat(2, 1fr); }
      .panel-pasos-fila  { grid-template-columns: repeat(2, 1fr); }

