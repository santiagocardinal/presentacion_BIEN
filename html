  <!-- ════════════════════════════════════════
       JAVASCRIPT
  ════════════════════════════════════════ -->
  <script>
    /* ══════════════════════════════════════════
       1. HEADER — sombra y fondo al hacer scroll
    ══════════════════════════════════════════ */
    const header = document.getElementById('header');

    window.addEventListener('scroll', () => {
      // Agrega clase '.fijo' después de 30px de scroll
      header.classList.toggle('fijo', window.scrollY > 30);
    });


    /* ══════════════════════════════════════════
       2. BOTÓN VOLVER ARRIBA
    ══════════════════════════════════════════ */
    const btnTop = document.getElementById('btn-top');

    window.addEventListener('scroll', () => {
      // Muestra el botón después de 400px de scroll
      btnTop.classList.toggle('visible', window.scrollY > 400);
    });

    btnTop.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });


    /* ══════════════════════════════════════════
       3. MENÚ HAMBURGUESA (mobile)
    ══════════════════════════════════════════ */
    const burger    = document.getElementById('burger');
    const navMobile = document.getElementById('navMobile');

    burger.addEventListener('click', () => {
      // Alterna clases 'abierto' en el botón y en el menú
      const abierto = burger.classList.toggle('abierto');
      navMobile.classList.toggle('abierto', abierto);
      // Accesibilidad: actualiza aria-expanded
      burger.setAttribute('aria-expanded', abierto);
    });

    // Cierra el menú al hacer click en cualquier enlace mobile
    document.querySelectorAll('.mob-link').forEach(link => {
      link.addEventListener('click', () => {
        burger.classList.remove('abierto');
        navMobile.classList.remove('abierto');
        burger.setAttribute('aria-expanded', 'false');
      });
    });


    /* ══════════════════════════════════════════
       4. ANIMACIONES FADE-IN AL HACER SCROLL
          IntersectionObserver detecta cuándo
          cada .aparece entra en el viewport
    ══════════════════════════════════════════ */
    const elementos = document.querySelectorAll('.aparece');

    const observador = new IntersectionObserver(
      (entradas) => {
        entradas.forEach(entrada => {
          if (entrada.isIntersecting) {
            // Agrega .visible → el CSS aplica la transición de aparición
            entrada.target.classList.add('visible');
            // Deja de observar el elemento (se anima solo una vez)
            observador.unobserve(entrada.target);
          }
        });
      },
      {
        threshold: 0.12  // Se activa cuando el 12% del elemento es visible
      }
    );

    // Registra todos los elementos animables
    elementos.forEach(el => observador.observe(el));

  </script>

