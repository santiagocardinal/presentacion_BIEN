      background: var(--tinta);
      color: rgba(255, 255, 255, 0.45);
      padding: 64px 0 32px;
    }

    .footer-grid {
      display: grid;
      grid-template-columns: 2fr 1fr 1fr;
      gap: 56px;
      padding-bottom: 44px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.07);
      margin-bottom: 28px;
