      background: #07121f;
      padding: 100px 28px 100px 64px;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    /* Cada ventaja / beneficio */
    .ventaja {
      display: flex;
      align-items: flex-start;
      gap: 18px;
      padding: 24px 18px;
      border-radius: var(--radio);
      transition: background 0.3s;
    }
    .ventaja:hover { background: rgba(255, 255, 255, 0.04); }
    .ventaja + .ventaja { border-top: 1px solid rgba(255, 255, 255, 0.05); }

    .vent-emoji {
      font-size: 1.5rem;
      line-height: 1;
      flex-shrink: 0;
      margin-top: 2px;
    }
    .vent-info strong {
      display: block;
      font-size: 0.94rem;
      font-weight: 600;
      color: var(--blanco);
      margin-bottom: 5px;
    }
    .vent-info p {
      font-size: 0.81rem;
      color: rgba(255, 255, 255, 0.40);
      line-height: 1.6;
    }

    /* ═══════════════════════════════════════════
       9. CALL TO ACTION
    ═══════════════════════════════════════════ */
    #contacto {
      padding: 112px 0;
      background: var(--palido);
      position: relative;
      overflow: hidden;
      text-align: center;
    }

    /* Resplandor de fondo */
    #contacto::before {
      content: '';
      position: absolute;
      top: 50%; left: 50%;
      transform: translate(-50%, -50%);
      width: 700px; height: 700px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(26, 79, 186, 0.08) 0%, transparent 70%);
      pointer-events: none;
    }

    /* Líneas decorativas de fondo */
    #contacto::after {
      content: '';
      position: absolute;
      inset: 0;
      background-image:
        linear-gradient(rgba(26, 79, 186, 0.04) 1px, transparent 1px),
        linear-gradient(90deg, rgba(26, 79, 186, 0.04) 1px, transparent 1px);
      background-size: 60px 60px;
      pointer-events: none;
    }

    .cta-caja {
      max-width: 580px;
      margin: 0 auto;
      position: relative;
      z-index: 1;
    }

    .cta-titulo {
      font-family: var(--f-display);
      font-size: clamp(2.2rem, 4.5vw, 3.6rem);
      font-weight: 400;
      color: var(--tinta);
      line-height: 1.08;
      margin-bottom: 18px;
