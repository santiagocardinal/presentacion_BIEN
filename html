<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>HG Estudio Contable – Servicios Contables Online</title>
  <meta name="description" content="Servicios contables simples, rápidos y seguros. Certificaciones, declaraciones juradas y asesoramiento. Atención 100% online." />

  <!-- ═══════════════════════════════════════
       FUENTES: Google Fonts (única dependencia
       externa permitida — solo tipografía)
  ════════════════════════════════════════ -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet" />

  <style>
    /* ═══════════════════════════════════════════
       1. VARIABLES GLOBALES
    ═══════════════════════════════════════════ */
    :root {
      /* Paleta principal — azules */
      --tinta:        #0a1628;   /* azul muy oscuro — textos, header, footer */
      --marino:       #0f2e5a;   /* azul marino profundo */
      --principal:    #1a4fba;   /* azul botones / acentos */
      --medio:        #2563eb;   /* azul medio hover */
      --suave:        #dbeafe;   /* azul pálido — fondos de chips */
      --palido:       #f0f5ff;   /* azul casi blanco — fondo hero y secciones */
      --blanco:       #ffffff;
      --gris:         #546480;   /* texto secundario */
      --linea:        #d4dff0;   /* bordes suaves */

      /* Verde WhatsApp */
      --verde:        #16a34a;
      --verde-hover:  #15803d;

      /* Instagram gradient */
      --ig-start:     #f97316;
      --ig-end:       #9333ea;

      /* Tipografía */
      --f-display: 'DM Serif Display', Georgia, serif;
      --f-body:    'DM Sans', system-ui, sans-serif;

      /* Espaciado y forma */
      --radio:    8px;
      --radio-lg: 16px;
      --trans:    all 0.28s cubic-bezier(0.16, 1, 0.3, 1);
      --sombra:   0 4px 24px rgba(10, 22, 40, 0.08);
      --sombra-h: 0 16px 48px rgba(10, 22, 40, 0.14);
    }

    /* ═══════════════════════════════════════════
       2. RESET Y BASE
    ═══════════════════════════════════════════ */
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html { scroll-behavior: smooth; }

    body {
      font-family: var(--f-body);
      background-color: var(--blanco);
      color: var(--tinta);
      line-height: 1.65;
      font-size: 16px;
      -webkit-font-smoothing: antialiased;
      overflow-x: hidden;
    }

    a    { text-decoration: none; color: inherit; }
    ul   { list-style: none; }
    img  { max-width: 100%; display: block; }

    /* ═══════════════════════════════════════════
       3. CONTENEDOR Y UTILIDADES
    ═══════════════════════════════════════════ */
    .wrap {
      max-width: 1120px;
      margin: 0 auto;
      padding: 0 28px;
    }

    /* Etiqueta de sección estilo "overline" */
    .overline {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      font-size: 0.68rem;
      font-weight: 600;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--principal);
      margin-bottom: 16px;
    }
    .overline::before {
      content: '';
      display: block;
      width: 28px;
      height: 1.5px;
      background: currentColor;
      flex-shrink: 0;
    }
    .overline.claro { color: rgba(147, 197, 253, 0.75); }

    /* Título de sección */
    .sec-titulo {
      font-family: var(--f-display);
      font-size: clamp(2rem, 3.8vw, 3rem);
      font-weight: 400;
      line-height: 1.1;
      margin-bottom: 16px;
    }

    /* Subtítulo de sección */
    .sec-sub {
      font-size: 0.97rem;
      color: var(--gris);
      line-height: 1.8;
      max-width: 480px;
    }

    /* ─── Animación de aparición por scroll ─── */
    .aparece {
      opacity: 0;
      transform: translateY(32px);
      transition: opacity 0.7s ease, transform 0.7s ease;
      transition-delay: var(--delay, 0s);
    }
    .aparece.visible {
      opacity: 1;
      transform: none;
    }

    /* ═══════════════════════════════════════════
       4. BOTONES
    ═══════════════════════════════════════════ */
    .btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 13px 26px;
      border-radius: var(--radio);
      font-family: var(--f-body);
      font-size: 0.88rem;
      font-weight: 600;
      cursor: pointer;
      border: 2px solid transparent;
      transition: var(--trans);
      white-space: nowrap;
      letter-spacing: 0.02em;
    }

    /* Azul sólido */
    .btn-azul {
      background: var(--principal);
      color: var(--blanco);
      border-color: var(--principal);
    }
    .btn-azul:hover {
      background: var(--marino);
      border-color: var(--marino);
      transform: translateY(-2px);
      box-shadow: 0 10px 28px rgba(26, 79, 186, 0.30);
    }

    /* Borde azul */
    .btn-borde {
      background: transparent;
      color: var(--principal);
      border-color: var(--principal);
    }
    .btn-borde:hover {
      background: var(--principal);
      color: var(--blanco);
      transform: translateY(-2px);
    }

    /* Verde WhatsApp */
    .btn-wa {
      background: var(--verde);
      color: var(--blanco);
      border-color: var(--verde);
    }
    .btn-wa:hover {
      background: var(--verde-hover);
      border-color: var(--verde-hover);
      transform: translateY(-2px);
      box-shadow: 0 10px 28px rgba(22, 163, 74, 0.28);
    }

    /* Instagram degradado */
    .btn-ig {
      background: linear-gradient(135deg, var(--ig-start), var(--ig-end));
      color: var(--blanco);
      border-color: transparent;
    }
    .btn-ig:hover {
      opacity: 0.88;
      transform: translateY(-2px);
      box-shadow: 0 10px 28px rgba(147, 51, 234, 0.28);
    }

    /* Blanco (sobre fondos oscuros) */
    .btn-blanco {
      background: var(--blanco);
      color: var(--tinta);
      border-color: var(--blanco);
    }
    .btn-blanco:hover {
      background: var(--palido);
      transform: translateY(-2px);
      box-shadow: 0 10px 28px rgba(255, 255, 255, 0.15);
    }

    /* ═══════════════════════════════════════════
       5. HEADER
    ═══════════════════════════════════════════ */
    #header {
      position: fixed;
      top: 0; left: 0; right: 0;
      z-index: 900;
      /* Transparente al inicio — JS agrega .fijo al hacer scroll */
      transition: background 0.35s ease, box-shadow 0.35s ease, border-color 0.35s ease;
    }

    #header.fijo {
      background: rgba(255, 255, 255, 0.97);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--linea);
      box-shadow: 0 2px 20px rgba(10, 22, 40, 0.06);
    }

    .nav-barra {
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 72px;
    }

    /* ── Logo ── */
    .logo {
      display: flex;
      align-items: center;
      gap: 13px;
    }

    /* ─────────────────────────────────────────
       LOGO: Reemplazar por imagen oficial proporcionada
    ───────────────────────────────────────── */
    .logo-caja {
      width: 48px;
      height: 48px;
      border-radius: 10px;
      background: var(--tinta);
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      flex-shrink: 0;
    }

    /*
      Para usar el logo real, eliminar el <span> dentro de .logo-caja
      y descomentar la siguiente regla:

      .logo-caja img {
        width: 100%;
        height: 100%;
        object-fit: contain;
      }
    */
    .logo-caja span {
      font-family: var(--f-display);
      font-size: 1.1rem;
      font-weight: 400;
      color: #93c5fd;
      letter-spacing: 1px;
      line-height: 1;
    }

    .logo-info {
      display: flex;
      flex-direction: column;
      line-height: 1.2;
    }
    .logo-nombre {
      font-family: var(--f-display);
      font-size: 1.08rem;
      color: var(--tinta);
    }
    .logo-subtitulo {
      font-size: 0.65rem;
      font-weight: 500;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--gris);
    }

    /* ── Nav desktop ── */
    .nav-desktop {
      display: flex;
      align-items: center;
      gap: 38px;
    }

    .nav-desktop a {
      font-size: 0.83rem;
      font-weight: 500;
      letter-spacing: 0.05em;
      color: var(--gris);
      position: relative;
      transition: color 0.25s;
    }
    .nav-desktop a::after {
      content: '';
      position: absolute;
      bottom: -3px; left: 0; right: 0;
      height: 1.5px;
      background: var(--principal);
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 0.25s ease;
    }
    .nav-desktop a:hover { color: var(--principal); }
    .nav-desktop a:hover::after { transform: scaleX(1); }

    /* Botón CTA en nav */
    .nav-cta {
      font-size: 0.83rem;
      font-weight: 600;
      color: var(--blanco) !important;
      background: var(--principal);
      padding: 9px 20px;
      border-radius: var(--radio);
      letter-spacing: 0.04em !important;
      transition: background 0.25s, transform 0.25s !important;
    }
    .nav-cta::after { display: none !important; }
    .nav-cta:hover {
      background: var(--marino) !important;
      transform: translateY(-1px);
    }

    /* ── Hamburguesa (mobile) ── */
    .burger {
      display: none;
      flex-direction: column;
      gap: 5px;
      background: none;
      border: none;
      cursor: pointer;
      padding: 4px;
    }
    .burger span {
      display: block;
      width: 24px;
      height: 1.5px;
      background: var(--tinta);
      border-radius: 2px;
      transition: var(--trans);
    }
    .burger.abierto span:nth-child(1) { transform: translateY(6.5px) rotate(45deg); }
    .burger.abierto span:nth-child(2) { opacity: 0; }
    .burger.abierto span:nth-child(3) { transform: translateY(-6.5px) rotate(-45deg); }

    /* ── Menú mobile ── */
    .nav-mobile {
      display: none;
      position: fixed;
      top: 72px; left: 0; right: 0;
      background: var(--blanco);
      border-bottom: 1px solid var(--linea);
      flex-direction: column;
      padding: 20px 28px 28px;
      gap: 0;
      z-index: 899;
      box-shadow: 0 8px 24px rgba(10, 22, 40, 0.08);
    }
    .nav-mobile.abierto { display: flex; }
    .nav-mobile a {
      font-size: 1rem;
      font-weight: 500;
      color: var(--tinta);
      padding: 15px 0;
      border-bottom: 1px solid var(--linea);
      transition: color 0.2s;
    }
    .nav-mobile a:last-child { border-bottom: none; }
    .nav-mobile a:hover { color: var(--principal); }

    /* ═══════════════════════════════════════════
       6. HERO — LAYOUT VERTICAL APILADO
          Arriba: contenido centrado
          Abajo:  panel oscuro con stats y pasos
    ═══════════════════════════════════════════ */
    #hero {
      display: flex;
      flex-direction: column;
      padding-top: 72px;
    }

    /* Bloque superior — contenido centrado */
    .hero-izq {
      background: var(--blanco);
      display: flex;
      flex-direction: column;
      align-items: center;        /* centra horizontalmente */
      text-align: center;         /* alinea el texto al centro */
      padding: 80px 28px 72px;
      width: 100%;
    }

    .hero-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-size: 0.7rem;
      font-weight: 600;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--principal);
      margin-bottom: 28px;
      justify-content: center;
    }
    .hero-badge::before {
      content: '';
      width: 28px;
      height: 1.5px;
      background: var(--principal);
    }

    .hero-titulo {
      font-family: var(--f-display);
      font-size: clamp(3rem, 5.5vw, 5.2rem);
      font-weight: 400;
      line-height: 1.0;
      margin-bottom: 24px;
      max-width: 700px;
    }
    /* Parte clara del título */
    .t-claro { display: block; color: var(--gris); }
    /* Parte fuerte del título */
    .t-oscuro { display: block; color: var(--tinta); }

    .hero-claim {
      font-size: 0.82rem;
      font-weight: 600;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--principal);
      margin-bottom: 18px;
    }

    .hero-desc {
      font-size: 0.98rem;
      color: var(--gris);
      line-height: 1.82;
      max-width: 520px;
      margin-bottom: 38px;
    }

    /* Grupo de botones CTA */
    .hero-cta {
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
      margin-bottom: 44px;
      justify-content: center;
    }

    /* Sellos de confianza */
    .hero-sellos {
      display: flex;
      gap: 22px;
      flex-wrap: wrap;
      justify-content: center;
    }
    .sello {
      display: flex;
      align-items: center;
      gap: 7px;
      font-size: 0.8rem;
      font-weight: 500;
      color: var(--gris);
    }
    .sello-dot {
      width: 28px;
      height: 28px;
      border-radius: 6px;
      background: var(--palido);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.85rem;
    }

    /* Panel inferior — oscuro con stats y pasos, ancho completo */
    .hero-der {
      background: var(--tinta);
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 64px 28px;
      position: relative;
      overflow: hidden;
      width: 100%;
    }

    /* Patrón de puntos de fondo */
    .hero-der::before {
      content: '';
      position: absolute;
      inset: 0;
      background-image: radial-gradient(circle, rgba(147, 197, 253, 0.10) 1px, transparent 1px);
      background-size: 28px 28px;
      pointer-events: none;
    }

    /* Arco decorativo */
    .hero-der::after {
      content: '';
      position: absolute;
      top: -120px; right: -120px;
      width: 420px; height: 420px;
      border-radius: 50%;
      border: 1px solid rgba(147, 197, 253, 0.07);
      pointer-events: none;
    }

    /* Contenedor interno del panel — ancho limitado y centrado */
    .hero-der-inner {
      width: 100%;
      max-width: 1120px;
      display: flex;
      flex-direction: column;
      align-items: center;
      position: relative;
    }

    /* Etiqueta del panel */
    .panel-etiqueta {
      font-size: 0.67rem;
      font-weight: 600;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: rgba(147, 197, 253, 0.5);
      margin-bottom: 32px;
      text-align: center;
    }

    /* Grid 2×2 estadísticas — en panel horizontal pasa a 4 columnas */
    .panel-stats {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1px;
      background: rgba(255, 255, 255, 0.07);
      border: 1px solid rgba(255, 255, 255, 0.07);
      border-radius: var(--radio-lg);
      overflow: hidden;
      margin-bottom: 40px;
      width: 100%;
      position: relative;
    }
    .stat {
      padding: 26px 20px;
      background: rgba(255, 255, 255, 0.03);
      transition: background 0.3s;
    }
    .stat:hover { background: rgba(255, 255, 255, 0.07); }
    .stat strong {
      display: block;
      font-family: var(--f-display);
      font-size: 2.6rem;
      font-weight: 400;
      color: var(--blanco);
      line-height: 1;
      margin-bottom: 6px;
    }
    .stat strong sup {
      font-size: 1.3rem;
      color: #93c5fd;
    }
    .stat span {
      font-size: 0.73rem;
      color: rgba(255, 255, 255, 0.38);
      line-height: 1.5;
    }

    /* Pasos del proceso — dispuestos en fila horizontal */
    .panel-pasos-titulo {
      font-size: 0.67rem;
      font-weight: 600;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: rgba(147, 197, 253, 0.5);
      margin-bottom: 20px;
      text-align: center;
      width: 100%;
    }

    /* Contenedor de pasos en fila */
    .panel-pasos-fila {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1px;
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid rgba(255, 255, 255, 0.06);
      border-radius: var(--radio-lg);
      overflow: hidden;
      width: 100%;
      margin-bottom: 28px;
    }

    .panel-paso {
      display: flex;
      align-items: flex-start;
      gap: 14px;
      padding: 22px 20px;
      background: rgba(255, 255, 255, 0.02);
      transition: background 0.3s;
    }
    .panel-paso:hover { background: rgba(255, 255, 255, 0.06); }

    .panel-paso-n {
      font-family: var(--f-display);
      font-size: 1.15rem;
      color: rgba(147, 197, 253, 0.45);
      min-width: 28px;
      line-height: 1.45;
      flex-shrink: 0;
    }
    .panel-paso p {
      font-size: 0.81rem;
      color: rgba(255, 255, 255, 0.5);
      line-height: 1.55;
    }

    /* Chips inferiores */
    .panel-chips {
      display: flex;
      flex-wrap: wrap;
      gap: 7px;
      justify-content: center;
      position: relative;
    }
    .chip {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 5px 13px;
      border-radius: 50px;
      font-size: 0.71rem;
      font-weight: 500;
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid rgba(255, 255, 255, 0.10);
      color: rgba(255, 255, 255, 0.60);
    }

    /* ═══════════════════════════════════════════
       7. SECCIÓN SERVICIOS
    ═══════════════════════════════════════════ */
    #servicios {
      padding: 112px 0;
      background: var(--blanco);
    }

    .sec-intro {
      text-align: center;
      margin-bottom: 64px;
    }
    .sec-intro .sec-sub {
      margin: 0 auto;
    }
    .sec-intro .overline {
      justify-content: center;
    }
    .sec-intro .overline::before { display: none; }

    /* Grid de tarjetas — flex centrado, 3 por fila, última centrada */
    .srv-grid {
      display: flex;
      flex-wrap: wrap;
      gap: 22px;
      justify-content: center;
    }

    .srv-tarjeta {
      flex: 1 1 calc(33.333% - 22px);
      max-width: calc(33.333% - 15px);
      background: var(--blanco);
      border: 1px solid var(--linea);
      border-radius: var(--radio-lg);
      padding: 34px 26px;
      position: relative;
      overflow: hidden;
      transition: var(--trans);
      cursor: default;
    }

    /* Línea de acento superior — aparece en hover */
    .srv-tarjeta::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 3px;
      background: linear-gradient(90deg, var(--principal), #60a5fa);
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 0.4s ease;
    }
    .srv-tarjeta:hover {
      border-color: var(--suave);
      box-shadow: var(--sombra-h);
      transform: translateY(-6px);
    }
    .srv-tarjeta:hover::before { transform: scaleX(1); }

    /* Ícono de servicio */
    .srv-icono {
      width: 52px;
      height: 52px;
      border-radius: 12px;
      background: var(--palido);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.4rem;
      margin-bottom: 20px;
      transition: background 0.3s, transform 0.35s ease;
    }
    .srv-tarjeta:hover .srv-icono {
      background: var(--suave);
      transform: scale(1.10) rotate(4deg);
    }

    .srv-tarjeta h3 {
      font-family: var(--f-display);
      font-size: 1.15rem;
      font-weight: 400;
      color: var(--tinta);
      margin-bottom: 10px;
      line-height: 1.2;
    }
    .srv-tarjeta p {
      font-size: 0.86rem;
      color: var(--gris);
      line-height: 1.72;
      margin-bottom: 18px;
    }

    /* Badge de servicio */
    .srv-badge {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      font-size: 0.74rem;
      font-weight: 600;
      color: var(--principal);
      background: var(--palido);
      padding: 5px 12px;
      border-radius: 50px;
      border: 1px solid var(--suave);
    }

    /* ═══════════════════════════════════════════
       8. SECCIÓN MODALIDAD — DOS MITADES
    ═══════════════════════════════════════════ */
    #modalidad {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }

    /* Mitad izquierda — azul marino */
    .mod-izq {
      background: var(--marino);
      padding: 100px 64px;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    .mod-titulo {
      font-family: var(--f-display);
      font-size: clamp(2.4rem, 4vw, 3.6rem);
      font-weight: 400;
      color: var(--blanco);
      line-height: 1.05;
      margin-bottom: 22px;
    }
    .mod-titulo em {
      font-style: italic;
      color: #93c5fd;
    }

    .mod-desc {
      font-size: 0.91rem;
      color: rgba(255, 255, 255, 0.5);
      line-height: 1.82;
      max-width: 360px;
      margin-bottom: 36px;
    }

    /* Estadísticas dentro de la columna oscura */
    .mod-stats {
      display: flex;
      gap: 32px;
      flex-wrap: wrap;
    }
    .mod-stat strong {
      display: block;
      font-family: var(--f-display);
      font-size: 2.2rem;
      color: var(--blanco);
      line-height: 1;
      margin-bottom: 4px;
    }
    .mod-stat span {
      font-size: 0.75rem;
      color: rgba(255, 255, 255, 0.4);
    }

    /* Mitad derecha — negro */
