      .mod-izq   { padding: 72px 28px; max-width: none; margin: 0; }
      .mod-der   { padding: 72px 28px; }

      /* Footer */
      .footer-grid { grid-template-columns: 1fr; gap: 36px; }
      .footer-pie  { flex-direction: column; gap: 8px; text-align: center; }
    }

    @media (max-width: 580px) {
